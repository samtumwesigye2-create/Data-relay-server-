# Central Data Relay Server
DRS_API_KEY=replace-with-long-random-admin-key
DRS_SERVICE_KEYS={"ugamap":"replace-ugamap-key","ugaship":"replace-ugaship-key","warehouse":"replace-warehouse-key","backup":"replace-backup-key"}
DRS_RETENTION_DAYS=90
DRS_CPU_ALERT=90
DRS_MEMORY_ALERT=90
DRS_DISK_ALERT=90
DRS_SLOW_QUERY_MS=1000
DRS_REPLICATION_LAG_SECONDS=30
DRS_BRUTE_FORCE_ATTEMPTS=5
DRS_BRUTE_FORCE_WINDOW_SECONDS=300

# Collector-side settings (set per monitored service, not on every server)
# DRS_URL=https://your-data-relay-server.example
# DRS_SERVICE_ID=ugamap
# DRS_SERVICE_KEY=replace-ugamap-key
# DRS_QUEUE_DB=drs_queue.db

# Backup collector settings (run beside the backup service)
# DRS_URL=https://your-data-relay-server.example
# DRS_SERVICE_ID=backup
# DRS_SERVICE_KEY=replace-backup-key
# BACKUP_HEALTH_URL=https://your-backup-service.example/health
# BACKUP_NAME=primary-backup
# BACKUP_CHECK_INTERVAL_SECONDS=60
# BACKUP_CHECK_TIMEOUT_SECONDS=8
